# Copy to .env and edit. NEVER commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-admin-token
REFRESH_INTERVAL_MINUTES=15
SCHEDULER_ENABLED=1
DEMO_MODE=0                # 1 = built-in simulated agency (offline testing only; use SOURCES_FILE=sources.demo.json)
DEMO_BASE_URL=http://127.0.0.1:5000
ALERT_MODE=demo            # demo = write alerts to data/alerts_demo.log ; smtp = real e-mail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@example.com
BOT_CONTACT=student@example.edu   # shown in the crawler User-Agent

# Real sources (see README 'Real data'): set after running  python manage.py inspect <url>
SR_PRESS_URL=
CMRL_URL=
